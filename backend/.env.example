# Server Port
PORT=5000

# Database Connection (local MongoDB or remote Atlas URI)
# In development, if left blank or set to 'memory', an in-memory database will spin up automatically.
MONGO_URI=mongodb://localhost:27017/learnhub

# JWT Auth Secret key (minimum 32 characters recommended for production)
JWT_SECRET=learnhub_jwt_secret_key_12345_987654321

# Client Frontend CORS Url
CLIENT_URL=http://localhost:5173
